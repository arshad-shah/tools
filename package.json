    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.0.7",
    "magic-string": "^0.30.21",
