{
  "name": "tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:csp": "pnpm build && playwright test -c playwright.csp.config.ts",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "icons:gen": "tsx scripts/gen-logo.ts && tsx --tsconfig tsconfig.app.json scripts/gen-favicon.ts && prettier --write src/shared/ui/icons/brand/logo-paths.ts",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "husky",
    "licences": "tsx scripts/licence-report.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arshad-shah/detent": "^0.3.1",
