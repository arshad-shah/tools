    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "plotly.js": "^3.5.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.16.0",
    "redux-persist": "^6.0.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-rewrite": "^4.0.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
