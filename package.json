    "@rive-app/react-canvas": "^4.28.6",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dagre": "^0.8.5",
    "diff": "^9.0.0",
    "dompurify": "^3.4.7",
    "lodash": "^4.18.1",
    "lucide-react": "^1.17.0",
