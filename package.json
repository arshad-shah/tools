      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "rollup@<4.59.0": "^4.59.0",
      "mdast-util-to-hast@<13.2.1": "^13.2.1",
      "js-yaml@<4.1.1": "^4.1.1",
      "react-router@<7.15.0": "^7.15.0"
    }
