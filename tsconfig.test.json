{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.d.ts",
    "test",
    "scripts",
    "vitest.config.ts",
    "build-info.ts",
    "playwright.config.ts",
    "playwright.visual.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
